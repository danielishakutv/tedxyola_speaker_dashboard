generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  passwordHash  String
  role          String   @default("admin") // "admin" or "editor"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  activities    Activity[]
}

model Speaker {
  id          String   @id @default(uuid())
  name        String
  email       String?
  phone       String?
  jobTitle    String?
  company     String?
  talkTitle   String
  description String?
  bio         String?
  imageUrl    String?
  socialLinks String?  // Will store stringified JSON array: [{"platform": "Twitter", "url": "..."}]
  status      String   @default("DRAFT") // "DRAFT" or "LIVE"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Media {
  id           String   @id @default(uuid())
  filename     String   // stored filename on disk (uuid-based)
  originalName String   // original filename from the user
  url          String   // public URL e.g. /uploads/abc123.jpg
  size         Int      // file size in bytes
  mimeType     String
  uploadedBy   String   // username
  createdAt    DateTime @default(now())
}

model Activity {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   // "LOGIN", "CREATE_SPEAKER", "UPDATE_SPEAKER", "DELETE_SPEAKER", etc.
  details   String?  // JSON stringified details
  timestamp DateTime @default(now())
}

model Sponsor {
  id          String   @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  website     String?
  status      String   @default("DRAFT") // "DRAFT" or "LIVE"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Blog {
  id          String   @id @default(uuid())
  title       String
  content     String   // Long text for blog post
  category    String
  author      String
  publishDate DateTime @default(now())
  status      String   @default("DRAFT") // "DRAFT" or "LIVE"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
