generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  name          String?  // optional display name (collected at self-registration)
  passwordHash  String
  role          String   @default("admin") // "admin" or "editor"
  // Account lifecycle. Defaults to APPROVED so every pre-existing user (admins,
  // editors) stays unlocked after `prisma db push`. Self-registration explicitly
  // sets PENDING; an admin then approves (APPROVED) or blocks (REJECTED).
  status        String   @default("APPROVED") // "PENDING" | "APPROVED" | "REJECTED"
  // When true, the user is forced to set a new password on their next login
  // (set by an admin password reset). Cleared once they change it.
  mustChangePassword Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  activities    Activity[]
  forumMemberships ForumMember[]
}

model Speaker {
  id          String   @id @default(uuid())
  name        String
  email       String?
  phone       String?
  jobTitle    String?
  company     String?
  talkTitle   String
  description String?
  bio         String?
  imageUrl    String?
  socialLinks String?  // Will store stringified JSON array: [{"platform": "Twitter", "url": "..."}]
  status      String   @default("DRAFT") // "DRAFT" or "LIVE"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Media {
  id           String   @id @default(uuid())
  filename     String   // stored filename on disk (uuid-based)
  originalName String   // original filename from the user
  url          String   // public URL e.g. /uploads/abc123.jpg
  size         Int      // file size in bytes
  mimeType     String
  uploadedBy   String   // username
  createdAt    DateTime @default(now())
}

model Activity {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   // "LOGIN", "CREATE_SPEAKER", "UPDATE_SPEAKER", "DELETE_SPEAKER", etc.
  details   String?  // JSON stringified details
  timestamp DateTime @default(now())
}

model Sponsor {
  id          String   @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  website     String?
  status      String   @default("DRAFT") // "DRAFT" or "LIVE"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Blog {
  id          String   @id @default(uuid())
  title       String
  content     String   // Rich-text HTML for the blog body
  category    String
  author      String
  imageUrl    String?  // Featured image (URL, uploaded file, or media-library pick)
  publishDate DateTime @default(now())
  status      String   @default("DRAFT") // "DRAFT" or "LIVE"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Accounts & Finance ──────────────────────────────────────
// An Account is a place money lives: cash box, bank account, mobile money, etc.
// Its balance is never stored — it is computed from openingBalance plus every
// transaction that touches it, so the numbers can never drift out of sync.
model Account {
  id             String        @id @default(uuid())
  name           String
  type           String        @default("BANK") // CASH | BANK | MOBILE | OTHER
  description    String?
  openingBalance Float         @default(0)      // balance before any recorded transaction
  archived       Boolean       @default(false)  // hide from pickers without deleting history
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Transactions whose primary account is this one (income into / expense from / transfer out of)
  transactions     Transaction[] @relation("AccountTxns")
  // Transactions transferred INTO this account
  transfersReceived Transaction[] @relation("TransferToAccount")
}

// A Transaction is one money movement. Three kinds:
//   INCOME   — money received into `account`
//   EXPENSE  — money spent from `account`
//   TRANSFER — money moved from `account` to `toAccount`
model Transaction {
  id          String   @id @default(uuid())
  type        String   @default("EXPENSE") // INCOME | EXPENSE | TRANSFER
  amount      Float
  category    String?  // e.g. Sponsorship, Tickets, Venue, Catering (free-text + presets)
  note        String?
  date        DateTime @default(now())

  accountId   String
  account     Account  @relation("AccountTxns", fields: [accountId], references: [id])

  // Only set when type = TRANSFER — the destination account
  toAccountId String?
  toAccount   Account? @relation("TransferToAccount", fields: [toAccountId], references: [id])

  createdBy   String?  // username who recorded it
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Forum ───────────────────────────────────────────────────
// Rooms are chat channels. The "general" room is seeded automatically and
// open to every authenticated user. All other rooms are admin-created and
// membership is explicit (ForumMember rows).
model ForumRoom {
  id          String        @id @default(uuid())
  name        String
  description String?
  isGeneral   Boolean       @default(false) // exactly one room has this true
  createdBy   String        // username of admin who created it
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  messages    ForumMessage[]
  members     ForumMember[]
}

model ForumMember {
  id        String    @id @default(uuid())
  roomId    String
  room      ForumRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime  @default(now())

  @@unique([roomId, userId])
}

model ForumMessage {
  id        String    @id @default(uuid())
  roomId    String
  room      ForumRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  username  String    // denormalised for fast reads
  body      String
  createdAt DateTime  @default(now())
}

model Popup {
  id          String    @id @default(uuid())
  title       String
  body        String
  buttonLabel String?   // CTA button text, e.g. "Get Tickets"
  buttonUrl   String?   // CTA button link
  imageUrl    String?   // Image (URL, uploaded file, or media-library pick)
  status      String    @default("DRAFT")            // "DRAFT" or "PUBLISHED"
  frequency   String    @default("ONCE_PER_SESSION") // EVERY_VISIT | ONCE_PER_SESSION | ONCE_PER_DAY | ONCE_EVER
  priority    Int       @default(0)                  // higher shows first when several are active
  startAt     DateTime?                              // null = show immediately once published
  endAt       DateTime?                              // null = no expiry; otherwise auto-hides after this day
  views       Int       @default(0)                  // impression counter (public tracking)
  clicks      Int       @default(0)                  // CTA click counter (public tracking)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
